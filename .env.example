# Vite는 VITE_ 접두사 변수만 클라이언트 번들에 노출한다.
# 실제 값은 .env.local 또는 배포 환경변수로 주입, 이 파일은 키 목록만.

# API 기본 URL. 비우면 '/api'로 폴백(MSW가 가로챔).
VITE_API_BASE_URL=

# MSW mock 강제 ON 플래그(배포/preview 빌드용).
# 로컬 dev는 DEV 감지로 항상 ON이라 이 값과 무관.
# 배포는 deploy-dev.yml이 지정.
VITE_ENABLE_MOCK=true

# 실 auth-service 로그인 사용(opt-in). true면 MSW 로그인 mock을 끄고
# /api/auth/login 을 vite proxy로 auth-user-service(:8081)에 보낸다.
# learning-service(:8082)가 수용하는 진짜 JWT가 필요한 HRD API Key 실연동 테스트용.
# 켜려면 auth-service를 LMS_BOOTSTRAP_ADMIN_ENABLED=true로 기동(admin@playdata.io / password123!).
VITE_REAL_AUTH=false

# dev 프록시 대상(미지정 시 기본값). 실연동 BE 포트가 다를 때만 override.
# vite.config.ts에서 process.env로 읽으므로 셸 환경변수로 지정해야 적용된다.
VITE_AUTH_API_TARGET=http://localhost:8081
VITE_HRD_API_TARGET=http://localhost:8082
